flowchart LR
    S(["Allocate"]) --> CHECKS
    subgraph CHECKS["All checks must pass"]
        direction LR
        T["1. Tier"] --> C["2. Official<br/>CGPA"] --> H["3. Weekly hours<br/>(faculty override)"] --> B["4. Exam<br/>blackout"] --> K["5. Compliance"]
    end
    CHECKS -- pass --> OK["Allocation<br/>proceeds"]
    CHECKS -- "any fails" --> X["Blocked<br/>with reasons"]
    style OK fill:#E8F5E9,stroke:#43A047
    style X fill:#FDECEA,stroke:#E53935
    style CHECKS fill:#FFFFFF,stroke:#C2DCF2
