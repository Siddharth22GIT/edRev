NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/edurev
JWT_SECRET=revalanche_dev_jwt_secret_key_change_in_production
# Session length (S5). In production JWT_SECRET must be 32+ characters and not the default above, or the API won't start.
JWT_EXPIRES_IN=1d

# Set to true to refuse to start without MongoDB (instead of falling back to in-memory demo data)
REQUIRE_DB=false

# Production (NODE_ENV=production) never falls back to demo data. Set to true only for a deliberate demo without MongoDB.
ALLOW_DEMO_MODE=false

# Per-user write limits (S9). Defaults: bids 30/hour, earnings 30/hour, messages 60 per 10 min, photo uploads 20/hour.
# RATE_LIMIT_BIDS=30
# RATE_LIMIT_EARNINGS=30
# RATE_LIMIT_MESSAGES=60
# RATE_LIMIT_UPLOADS=20
